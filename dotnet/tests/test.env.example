# Copy this file to test.env (same folder) and fill in the passwords you chose
# in dotnet/database/setup/create-dev-accounts.sql. test.env is git-ignored.

# Servers to test against, comma-separated host:port. A server that can't be
# reached makes its tests fail; remove it from the list to skip it.
TEST_SERVERS=localhost:3306,localhost:3308

# Creates and drops the throwaway probeta_test_* databases.
TEST_ADMIN_USER=specimen_test
TEST_ADMIN_PASSWORD=

# Restricted account (SELECT, INSERT, UPDATE only) the app's queries run as.
TEST_APP_USER=specimen_app_test
TEST_APP_PASSWORD=
