<!--
    Window icons and the line icons used on buttons.
    Line icons are drawn on a 16 x 16 grid and stroked with the Foreground of the
    control they sit in; use them as  <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Search}" />
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window icons -->
    <BitmapImage x:Key="WindowIcon.App" UriSource="pack://application:,,,/ProbetaControl;component/Assets/app.png" />

    <!-- Line icons (16 x 16) -->
    <Geometry x:Key="Icon.Search">M 12,7 A 5,5 0 1 1 2,7 A 5,5 0 1 1 12,7 M 10.6,10.6 L 14.5,14.5</Geometry>
    <Geometry x:Key="Icon.Plus">M 8,2.5 V 13.5 M 2.5,8 H 13.5</Geometry>
    <Geometry x:Key="Icon.Edit">M 2.5,13.5 L 3,10.5 L 11,2.5 L 13.5,5 L 5.5,13 Z M 9.5,4 L 12,6.5</Geometry>
    <Geometry x:Key="Icon.Copy">M 5.5,5.5 H 14.5 V 14.5 H 5.5 Z M 10.5,5.5 V 1.5 H 1.5 V 10.5 H 5.5</Geometry>
    <Geometry x:Key="Icon.Archive">M 1.5,2.5 H 14.5 V 5.5 H 1.5 Z M 2.5,5.5 V 13.5 H 13.5 V 5.5 M 6,8.5 H 10</Geometry>
    <Geometry x:Key="Icon.Restore">M 2.5,6 H 10 A 4,4 0 0 1 10,14 H 5 M 5.5,3 L 2.5,6 L 5.5,9</Geometry>
    <Geometry x:Key="Icon.Lock">M 3,7.5 H 13 V 14.5 H 3 Z M 5,7.5 V 5 A 3,3 0 0 1 11,5 V 7.5</Geometry>
    <Geometry x:Key="Icon.Unlock">M 3,7.5 H 13 V 14.5 H 3 Z M 5,7.5 V 5 A 3,3 0 0 1 10.8,3.9</Geometry>
    <Geometry x:Key="Icon.Print">M 4,6 V 1.5 H 12 V 6 M 4,11.5 H 2 V 6 H 14 V 11.5 H 12 M 4,9.5 H 12 V 14.5 H 4 Z</Geometry>
    <Geometry x:Key="Icon.Document">M 3,1.5 H 10 L 13,4.5 V 14.5 H 3 Z M 10,1.5 V 4.5 H 13 M 5.5,8.5 H 10.5 M 5.5,11.5 H 10.5</Geometry>
    <Geometry x:Key="Icon.Sheet">M 1.5,2.5 H 14.5 V 13.5 H 1.5 Z M 1.5,6 H 14.5 M 1.5,9.75 H 14.5 M 6,2.5 V 13.5</Geometry>
    <Geometry x:Key="Icon.Filter">M 1.5,2.5 H 14.5 L 9.5,8.5 V 13.5 L 6.5,12 V 8.5 Z</Geometry>
    <Geometry x:Key="Icon.FilterOff">M 1.5,2.5 H 14.5 L 9.5,8.5 V 13.5 L 6.5,12 V 8.5 Z M 1.5,14.5 L 14.5,1.5</Geometry>
    <Geometry x:Key="Icon.Warning">M 8,1.5 L 15,14 H 1 Z M 8,6 V 9.5 M 8,11.5 V 12</Geometry>
    <Geometry x:Key="Icon.Help">M 15,8 A 7,7 0 1 1 1,8 A 7,7 0 1 1 15,8 M 6,6.2 A 2,2 0 1 1 8.6,8 C 8.1,8.3 8,8.7 8,9.6 M 8,11.6 V 12</Geometry>
    <Geometry x:Key="Icon.User">M 11,5 A 3,3 0 1 1 5,5 A 3,3 0 1 1 11,5 M 2,15 C 2,11.5 5,9.5 8,9.5 C 11,9.5 14,11.5 14,15</Geometry>
    <Geometry x:Key="Icon.Logout">M 6,2 H 2.5 V 14 H 6 M 10,5 L 13.5,8 L 10,11 M 13.5,8 H 6</Geometry>
    <Geometry x:Key="Icon.Close">M 3.5,3.5 L 12.5,12.5 M 12.5,3.5 L 3.5,12.5</Geometry>
    <Geometry x:Key="Icon.Refresh">M 13.5,8 A 5.5,5.5 0 1 1 11.9,4.1 M 12,1 V 4.5 H 8.5</Geometry>
    <Geometry x:Key="Icon.Settings">M 1.5,4 H 14.5 M 1.5,8 H 14.5 M 1.5,12 H 14.5 M 5,2.5 V 5.5 M 11,6.5 V 9.5 M 7,10.5 V 13.5</Geometry>
    <Geometry x:Key="Icon.Qr">M 1.5,1.5 H 6.5 V 6.5 H 1.5 Z M 9.5,1.5 H 14.5 V 6.5 H 9.5 Z M 1.5,9.5 H 6.5 V 14.5 H 1.5 Z M 9.5,9.5 H 11.5 M 13.5,9.5 H 14.5 M 9.5,12 H 14.5 M 9.5,14.5 H 11.5</Geometry>
    <Geometry x:Key="Icon.Specimen">M 3,3.5 A 5,1.5 0 1 0 13,3.5 A 5,1.5 0 1 0 3,3.5 M 3,3.5 V 12.5 A 5,1.5 0 0 0 13,12.5 V 3.5</Geometry>
    <Geometry x:Key="Icon.Save">M 2.5,1.5 H 11.5 L 14.5,4.5 V 14.5 H 1.5 V 1.5 Z M 4.5,1.5 V 5.5 H 10.5 V 1.5 M 4.5,14.5 V 9.5 H 11.5 V 14.5</Geometry>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>

</ResourceDictionary>
