<!--
    Every colour in the app lives here. Views never set colours themselves:
    they use the Brush.* keys below (or the styles in Controls.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand -->
    <Color x:Key="Color.Primary">#1D4CB8</Color>
    <Color x:Key="Color.PrimaryHover">#173F9C</Color>
    <Color x:Key="Color.PrimaryPressed">#11327D</Color>
    <Color x:Key="Color.PrimarySoft">#E7EDFA</Color>
    <Color x:Key="Color.Accent">#F2C230</Color>
    <Color x:Key="Color.Header">#111A2C</Color>
    <Color x:Key="Color.HeaderText">#FFFFFF</Color>
    <Color x:Key="Color.HeaderMutedText">#B8C2D3</Color>

    <!-- Neutrals -->
    <Color x:Key="Color.Page">#F3F5F8</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceHover">#F1F3F6</Color>
    <Color x:Key="Color.SurfacePressed">#E5E8ED</Color>
    <Color x:Key="Color.SurfaceMuted">#F7F8FA</Color>
    <Color x:Key="Color.Border">#D3D9E1</Color>
    <Color x:Key="Color.BorderHover">#A8B2C0</Color>
    <Color x:Key="Color.Divider">#ECEFF3</Color>
    <Color x:Key="Color.RowHover">#F4F7FD</Color>

    <!-- Text -->
    <Color x:Key="Color.Text">#1F2937</Color>
    <Color x:Key="Color.TextSecondary">#4B5563</Color>
    <Color x:Key="Color.TextMuted">#6B7280</Color>
    <Color x:Key="Color.TextDisabled">#A0A7B2</Color>
    <Color x:Key="Color.TextOnPrimary">#FFFFFF</Color>

    <!-- Status -->
    <Color x:Key="Color.Error">#B42318</Color>
    <Color x:Key="Color.ErrorSoft">#FDF1F0</Color>
    <Color x:Key="Color.Warning">#D97706</Color>
    <Color x:Key="Color.WarningSoft">#FFF7E6</Color>
    <Color x:Key="Color.Success">#067647</Color>
    <Color x:Key="Color.SuccessSoft">#ECFDF3</Color>

    <!-- Rows -->
    <Color x:Key="Color.RowOverdue">#FBE1DE</Color>
    <Color x:Key="Color.RowDueSoon">#FDF0C4</Color>
    <Color x:Key="Color.ArchivedText">#8B929E</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="{StaticResource Color.PrimarySoft}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Header" Color="{StaticResource Color.Header}" />
    <SolidColorBrush x:Key="Brush.HeaderText" Color="{StaticResource Color.HeaderText}" />
    <SolidColorBrush x:Key="Brush.HeaderMutedText" Color="{StaticResource Color.HeaderMutedText}" />

    <SolidColorBrush x:Key="Brush.Page" Color="{StaticResource Color.Page}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="{StaticResource Color.SurfaceMuted}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="{StaticResource Color.BorderHover}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}" />

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="{StaticResource Color.TextOnPrimary}" />

    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.ErrorSoft" Color="{StaticResource Color.ErrorSoft}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />

    <SolidColorBrush x:Key="Brush.RowOverdue" Color="{StaticResource Color.RowOverdue}" />
    <SolidColorBrush x:Key="Brush.RowDueSoon" Color="{StaticResource Color.RowDueSoon}" />
    <SolidColorBrush x:Key="Brush.ArchivedText" Color="{StaticResource Color.ArchivedText}" />

    <!-- Derived (palette colours with transparency only) -->
    <SolidColorBrush x:Key="Brush.HeaderHover" Color="{StaticResource Color.HeaderText}" Opacity="0.08" />
    <SolidColorBrush x:Key="Brush.HeaderSelected" Color="{StaticResource Color.HeaderText}" Opacity="0.14" />
    <SolidColorBrush x:Key="Brush.BusyOverlay" Color="{StaticResource Color.Page}" Opacity="0.80" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

</ResourceDictionary>
