<Project>
  <PropertyGroup>
    <AssemblyName>ProbetaControl</AssemblyName>
    <IntermediateOutputPath>obj\Release\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\Johnny\Documents\Code\controle_test_cp\dotnet\src\ProbetaControl\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>ProbetaControl</_TargetAssemblyProjectName>
    <RootNamespace>ProbetaControl</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProbetaControl</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Probeta Control</AssemblyTitle>
    <!-- Delivery is one .exe: no .pdb, no .exe.config next to it. -->
    <DebugType>embedded</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <!-- The installer guarantees .NET 4.8 and the app checks it at startup, so no .exe.config is needed. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Stay on 6.2.x: 6.5.0 and later are AGPL / commercial (runtime license check); 6.2.4 is MIT. -->
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="6.2.4" />
    <!-- QR labels (MIT, no dependencies); PngByteQRCode writes the PNG itself. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reports: GDI+ drawing (preview pages, printing) and the Windows print dialog. -->
  </ItemGroup>
  <ItemGroup>
    <!-- Also the window icon (title bar, taskbar); the exe's own icon comes from ApplicationIcon. -->
  </ItemGroup>
  <ItemGroup>
    <!-- Numbered schema scripts travel inside the exe; resource name = DbScripts.<file name>. -->
    <EmbeddedResource Include="Database\Scripts\*.sql" LogicalName="DbScripts.%(Filename)%(Extension)" />
    <!-- The built-in help page (F1), shown by Views/Help/HelpViewer. -->
    <EmbeddedResource Include="Help\ayuda.html" LogicalName="Help.ayuda.html" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProbetaControl.Tests" />
    <!-- The one-off legacy import writes the same audit rows as the program. -->
    <InternalsVisibleTo Include="LegacyImport" />
  </ItemGroup>
