<Application x:Class="ProbetaControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProbetaControl.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Controls.xaml merges Colors.xaml and Icons.xaml. -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <views:InverseBoolConverter x:Key="InverseBool" />
            <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <views:MinWidthToVisibilityConverter x:Key="MinWidthToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
