<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ProbetaControl</AssemblyName>
    <RootNamespace>ProbetaControl</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Probeta Control</AssemblyTitle>

    <!-- Delivery is one .exe: no .pdb, no .exe.config next to it. -->
    <DebugType>embedded</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <!-- The installer guarantees .NET 4.8 and the app checks it at startup, so no .exe.config is needed. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Numbered schema scripts travel inside the exe; resource name = DbScripts.<file name>. -->
    <EmbeddedResource Include="Database\Scripts\*.sql" LogicalName="DbScripts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProbetaControl.Tests" />
  </ItemGroup>

</Project>
