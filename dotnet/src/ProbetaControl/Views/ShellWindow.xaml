<Window x:Class="ProbetaControl.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProbetaControl.ViewModels"
        xmlns:views="clr-namespace:ProbetaControl.Views"
        xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors"
        xmlns:catalog="clr-namespace:ProbetaControl.ViewModels.Catalog"
        xmlns:catalogViews="clr-namespace:ProbetaControl.Views.Catalog"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}"
        Width="1200" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        x:Name="Root">

    <Window.Resources>
        <!-- Page view model → view. -->
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <views:PlaceholderPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type catalog:ClientsPageViewModel}">
            <catalogViews:ContactListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type catalog:ProvidersPageViewModel}">
            <catalogViews:ContactListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type catalog:MaterialsPageViewModel}">
            <catalogViews:MaterialListView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Background="{StaticResource Brush.Header}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Narrow window: title text hides below 900 px, user name below 1100 px (icon tooltip instead). -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,20,0">
                <Image Source="{StaticResource WindowIcon.App}" Width="26" Height="26" ToolTip="Probeta Control"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock Text="Probeta Control" Margin="10,0,8,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Section}" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.HeaderText}"
                           Visibility="{Binding ActualWidth, ElementName=Root, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=900}" />
            </StackPanel>

            <ListBox Grid.Column="1" Style="{StaticResource HeaderNavList}"
                     ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedNavigationItem}"
                     DisplayMemberPath="Title" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,16,0" VerticalAlignment="Center">
                <Border Background="{StaticResource Brush.Transparent}" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border.ToolTip>
                        <TextBlock>
                            <Run Text="{Binding CurrentUserName, Mode=OneWay}" /><LineBreak /><Run Text="{Binding CurrentUserRole, Mode=OneWay}" />
                        </TextBlock>
                    </Border.ToolTip>
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.User}"
                          Stroke="{StaticResource Brush.HeaderMutedText}" />
                </Border>
                <StackPanel Margin="-4,0,16,0" VerticalAlignment="Center"
                            Visibility="{Binding ActualWidth, ElementName=Root, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=1100}">
                    <TextBlock Text="{Binding CurrentUserName}" Foreground="{StaticResource Brush.HeaderText}" />
                    <TextBlock Text="{Binding CurrentUserRole}" Foreground="{StaticResource Brush.HeaderMutedText}"
                               FontSize="{StaticResource FontSize.Small}" />
                </StackPanel>
                <Button Style="{StaticResource HeaderIconButton}" Command="{Binding LogoutCommand}"
                        Width="30" Height="30" Padding="0" ToolTip="Cerrar sesión" Margin="0,0,8,0"
                        AutomationProperties.Name="Cerrar sesión" b:ButtonIcon.Icon="{StaticResource Icon.Logout}" />
                <Button Style="{StaticResource HeaderIconButton}" Command="{Binding HelpCommand}"
                        Width="30" Height="30" Padding="0" ToolTip="Ayuda (F1)" AutomationProperties.Name="Ayuda"
                        Content="?" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Accent line -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Accent}" />

        <!-- Page -->
        <Grid Grid.Row="2">
            <ContentControl Content="{Binding CurrentPage}" Focusable="False" Margin="24,20,24,20" />

            <!-- Busy overlay for the current page -->
            <Grid Background="{StaticResource Brush.BusyOverlay}"
                  Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" MaxWidth="360" Padding="20" Margin="16"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPage.BusyMessage}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ProgressBar IsIndeterminate="{Binding CurrentPage.IsBusy}" />
                        <Button Content="Cancelar" HorizontalAlignment="Right" Margin="0,16,0,0"
                                Command="{Binding CurrentPage.CancelBusyCommand}"
                                Visibility="{Binding CurrentPage.CanCancelBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
