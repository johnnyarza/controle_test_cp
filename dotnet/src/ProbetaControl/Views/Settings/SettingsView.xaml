<!-- Configuración: side menu of sections (grouped) and the selected section's panel. -->
<UserControl x:Class="ProbetaControl.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:ProbetaControl.ViewModels.Settings"
             xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedSections" Source="{Binding Sections}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Menu entry: icon + title; selected = soft blue with dark blue text. -->
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- The border is always 1 px (transparent until focused) so focusing never shifts the text. -->
                        <Border x:Name="Root" Background="{StaticResource Brush.Transparent}" CornerRadius="{StaticResource Radius.Control}"
                                BorderBrush="{StaticResource Brush.Transparent}" BorderThickness="1" Padding="9,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.PrimaryPressed}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ===== Usuarios ===== -->
        <DataTemplate DataType="{x:Type s:UsersSectionViewModel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Usuarios" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Text="Los usuarios nuevos eligen su contraseña al entrar por primera vez." />
                </DockPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource MessageBanner}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>

                <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                    <Button Style="{StaticResource PrimaryButton}" Content="Nuevo usuario" Command="{Binding NewCommand}"
                            b:ButtonIcon.Icon="{StaticResource Icon.Plus}" Margin="0,0,8,8" />
                    <Button Content="Editar" Command="{Binding EditCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Edit}" Margin="0,0,8,8" />
                    <Button Content="Restablecer contraseña…" Command="{Binding ResetPasswordCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Lock}"
                            Margin="0,0,8,8" ToolTip="Contraseña temporal que el usuario cambia al entrar (no para su propio usuario)"
                            ToolTipService.ShowOnDisabled="True" />
                    <Button Content="{Binding ArchiveText}" Command="{Binding ToggleArchiveCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Archive}"
                            Margin="0,0,8,8" ToolTip="Un usuario archivado no puede iniciar sesión (no para su propio usuario)"
                            ToolTipService.ShowOnDisabled="True" />
                    <CheckBox Content="Mostrar archivados" IsChecked="{Binding IncludeArchived}" VerticalAlignment="Center" Margin="8,0,0,8" />
                </WrapPanel>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,8,0,0">
                    <Run Text="{Binding CountText, Mode=OneWay}" />
                    <Run Text="· Debe quedar al menos un administrador activo. Su propio usuario no se archiva ni se restablece aquí." />
                </TextBlock>

                <Grid MinHeight="160">
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                              RowStyle="{StaticResource ArchivableDataGridRow}"
                              b:DataGridBehavior.OpenCommand="{Binding EditCommand}" AutomationProperties.Name="Usuarios">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding UserName}" Width="*" MinWidth="100" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding FullName}" Width="2*" MinWidth="120" />
                            <DataGridTextColumn Header="Rol" Binding="{Binding RoleText}" Width="110" MinWidth="100" />
                            <DataGridTemplateColumn Header="Estado" Width="1.2*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Chip" HorizontalAlignment="Left" Padding="0" Background="{StaticResource Brush.Transparent}"
                                                CornerRadius="9">
                                            <TextBlock x:Name="Text" Text="{Binding StatusText}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding MustChangePassword}" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource Brush.WarningSoft}" />
                                                <Setter TargetName="Chip" Property="Padding" Value="8,0" />
                                                <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ProgressBar VerticalAlignment="Top" Height="3" Margin="1,1,1,0" IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- ===== Logo y sello ===== -->
        <DataTemplate x:Key="ImageSlotTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize.Section}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding InfoText}" />
                    </StackPanel>
                    <Border Height="170" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                            Background="{StaticResource Brush.SurfaceMuted}" Margin="0,0,0,10">
                        <Grid>
                            <Image Source="{Binding Bytes, Converter={StaticResource BytesToImage}}" Stretch="Uniform" Margin="10"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Title}" />
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding EmptyText}" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                       Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MessageBanner}">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Image]}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ChooseText}" Command="{Binding ChooseCommand}"
                                Margin="0,0,8,0" ToolTip="PNG o JPG, máximo 2 MB. Se guarda al elegirla." />
                        <Button Content="Quitar" Command="{Binding RemoveCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Trash}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type s:ReportImagesSectionViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Logo y sello" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,14" MaxWidth="760" HorizontalAlignment="Left"
                               Text="Imágenes que se imprimen en los informes. Se guardan en la base de datos, así que son las mismas en todos los equipos. PNG o JPG, máximo 2 MB." />
                    <UniformGrid Columns="2">
                        <ContentControl Content="{Binding Logo}" ContentTemplate="{StaticResource ImageSlotTemplate}" Focusable="False" />
                        <ContentControl Content="{Binding Stamp}" ContentTemplate="{StaticResource ImageSlotTemplate}" Focusable="False" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ===== Conexión ===== -->
        <DataTemplate DataType="{x:Type s:ConnectionSectionViewModel}">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Conexión de este equipo" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,14"
                           Text="Servidor MySQL y cuenta que usa el programa en este equipo. Se guardan cifrados junto al programa." />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource InfoLabel}" Text="Servidor" />
                    <TextBlock Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding Server}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource InfoLabel}" Text="Base de datos" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding Database}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource InfoLabel}" Text="Cuenta de MySQL" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding UserName}" />
                </Grid>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                           Text="Para cambiarla se cierra la sesión; después de guardar los datos nuevos se vuelve a iniciar sesión." />
                <Button Content="Cambiar conexión…" Command="{Binding ChangeCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Settings}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <!-- ===== Mi contraseña ===== -->
        <DataTemplate DataType="{x:Type s:MyPasswordSectionViewModel}">
            <StackPanel Width="380" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Mi contraseña" Margin="0,0,0,14" />
                <Border Style="{StaticResource MessageBanner}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Contraseña actual" />
                    <PasswordBox b:PasswordBoxBinding.Password="{Binding CurrentPassword}" AutomationProperties.Name="Contraseña actual" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[CurrentPassword]}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Contraseña nueva" />
                    <PasswordBox b:PasswordBoxBinding.Password="{Binding NewPassword}" AutomationProperties.Name="Contraseña nueva" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[NewPassword]}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Repetir contraseña nueva" />
                    <PasswordBox b:PasswordBoxBinding.Password="{Binding ConfirmPassword}" AutomationProperties.Name="Repetir contraseña nueva" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[ConfirmPassword]}" />
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Rule}" Margin="0,0,0,12" />
                <Button Style="{StaticResource PrimaryButton}" Content="Cambiar contraseña" Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <!-- ===== Acerca de ===== -->
        <DataTemplate DataType="{x:Type s:AboutSectionViewModel}">
            <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                <DockPanel Margin="0,0,0,16">
                    <Image DockPanel.Dock="Left" Source="{StaticResource WindowIcon.App}" Width="40" Height="40" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontSize="{StaticResource FontSize.Section}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}">
                            <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Copyright, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource MessageBanner}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource InfoLabel}" Text="Base de datos" />
                    <TextBlock Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding SchemaVersion}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource InfoLabel}" Text="Servidor MySQL" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding ServerVersion}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource InfoLabel}" Text="Equipo" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding MachineName}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource InfoLabel}" Text="Registros" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" Text="{Binding LogFolder}" />
                </Grid>
                <Button Content="Abrir carpeta de registros" Command="{Binding OpenLogFolderCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Document}"
                        HorizontalAlignment="Left" ToolTip="Los registros ayudan a soporte a encontrar errores" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Title}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="6" VerticalAlignment="Top">
                <ListBox ItemsSource="{Binding Source={StaticResource GroupedSections}}" SelectedItem="{Binding SelectedSection}"
                         ItemContainerStyle="{StaticResource SettingsNavItem}" BorderThickness="0" Background="{StaticResource Brush.Transparent}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Secciones de configuración">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="10,10,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{Binding IconKey, Converter={StaticResource ResourceKey}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ContentControl Content="{Binding SelectedSection}" Focusable="False" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
