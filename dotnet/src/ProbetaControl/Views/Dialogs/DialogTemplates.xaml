<!-- Dialog contents (view model → template), shown inside DialogWindow. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="clr-namespace:ProbetaControl.ViewModels.Infrastructure"
                    xmlns:c="clr-namespace:ProbetaControl.ViewModels.Catalog"
                    xmlns:t="clr-namespace:ProbetaControl.ViewModels.CompressionTests"
                    xmlns:st="clr-namespace:ProbetaControl.ViewModels.Settings"
                    xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors">

    <!-- Yes / no question -->
    <DataTemplate DataType="{x:Type i:ConfirmDialogViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,20" />
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0"
                        b:FocusBehavior.FocusOnLoad="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Warning with a single button -->
    <DataTemplate DataType="{x:Type i:MessageDialogViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Warning}" Stroke="{StaticResource Brush.Warning}"
                      Margin="0,0,8,0" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0" />
            </StackPanel>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,20" />
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Style="{StaticResource PrimaryButton}" Content="Aceptar" Command="{Binding CloseCommand}"
                        IsDefault="True" IsCancel="True" b:FocusBehavior.FocusOnLoad="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Client / provider form (same fields) -->
    <DataTemplate x:Key="ContactEditorTemplate">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,16" />

            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" b:FocusBehavior.FocusOnLoad="True" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Name]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Teléfono" />
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Phone]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Dirección" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Address]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Correo electrónico" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Email]}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type c:ClientEditorViewModel}">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContactEditorTemplate}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type c:ProviderEditorViewModel}">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContactEditorTemplate}" />
    </DataTemplate>

    <!-- Material form -->
    <DataTemplate DataType="{x:Type c:MaterialEditorViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,16" />

            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" b:FocusBehavior.FocusOnLoad="True" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Name]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Tipo" />
                <ComboBox ItemsSource="{Binding MaterialTypeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding MaterialType}" AutomationProperties.Name="Tipo"
                          ToolTip="Con Cemento y Agua, las dosificaciones calculan la relación agua/cemento (a/c)" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[MaterialType]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Proveedor" />
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" DisplayMemberPath="Name"
                          AutomationProperties.Name="Proveedor" />
            </StackPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Concrete design form: description, fck, slump and the material table (up to 8 rows) -->
    <DataTemplate DataType="{x:Type c:DesignEditorViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,16" />

            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <!-- Used by tests: changes reach their reports (operators: view only). -->
            <Border Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}" Padding="10,8" Margin="0,0,0,14"
                    Visibility="{Binding UsageWarning, Converter={StaticResource NotEmptyToVisibility}}">
                <DockPanel>
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Warning}" Stroke="{StaticResource Brush.Warning}"
                          VerticalAlignment="Top" Margin="0,1,8,0" />
                    <TextBlock Text="{Binding UsageWarning}" TextWrapping="Wrap" AutomationProperties.Name="Aviso" />
                </DockPanel>
            </Border>

            <StackPanel IsEnabled="{Binding CanEdit}">
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Descripción" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
                         AutomationProperties.Name="Descripción" b:FocusBehavior.FocusOnLoad="True" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Description]}" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="fck (kg/cm²)" />
                    <TextBox Text="{Binding Fck, UpdateSourceTrigger=PropertyChanged}" MaxLength="12"
                             AutomationProperties.Name="fck (kg/cm²)" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Fck]}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Slump (cm, opcional)" />
                    <TextBox Text="{Binding Slump, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                             AutomationProperties.Name="Slump (cm)" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Slump]}" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Materiales" Margin="0,4,0,6" />

            <!-- The table: header, one row per material, footer with the actions and the total.
                 Header and rows share the column widths: number | material | quantity | row buttons. -->
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource Brush.Surface}">
                <StackPanel>
                    <Border Background="{StaticResource Brush.SurfaceMuted}" Padding="8,6"
                            BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1"
                            CornerRadius="3,3,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="#" Margin="0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="Material" Margin="0" />
                            <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="kg/m³" Margin="0"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource MutedText}" Margin="8,10" TextWrapping="Wrap"
                               Text="Sin materiales. Use &quot;Agregar material&quot; para agregar el primero."
                               Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" KeyboardNavigation.TabNavigation="Continue"
                                  AutomationProperties.Name="Materiales">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Number}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Material}"
                                                  DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName"
                                                  AutomationProperties.Name="{Binding MaterialLabel}"
                                                  b:FocusBehavior.FocusOnLoad="{Binding FocusOnLoad, Mode=OneTime}" />
                                        <TextBox Grid.Column="3" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Right" MaxLength="14" IsEnabled="{Binding IsFilled}"
                                                 AutomationProperties.Name="{Binding QuantityLabel}" />
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource SubtleButton}" Command="{Binding MoveUpCommand}"
                                                    Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0"
                                                    b:ButtonIcon.Icon="{StaticResource Icon.ArrowUp}"
                                                    ToolTip="Subir" AutomationProperties.Name="Subir" />
                                            <Button Style="{StaticResource SubtleButton}" Command="{Binding MoveDownCommand}"
                                                    Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0" Margin="4,0"
                                                    b:ButtonIcon.Icon="{StaticResource Icon.ArrowDown}"
                                                    ToolTip="Bajar" AutomationProperties.Name="Bajar" />
                                            <Button Style="{StaticResource SubtleButton}" Command="{Binding RemoveCommand}"
                                                    Width="28" Height="28" MinHeight="28" MinWidth="28" Padding="0"
                                                    b:ButtonIcon.Icon="{StaticResource Icon.Trash}"
                                                    ToolTip="Quitar este material" AutomationProperties.Name="Quitar material" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                                                   Style="{StaticResource FieldError}" Text="{Binding Error}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Total, under the quantity column. -->
                    <Border Padding="8,6" Background="{StaticResource Brush.SurfaceMuted}"
                            BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{Binding WaterCementRatioText}" FontWeight="SemiBold"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       ToolTip="{Binding WaterCementRatioToolTip}" ToolTipService.ShowOnDisabled="True"
                                       AutomationProperties.Name="Relación agua/cemento" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="Total" Margin="0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Margin="0,0,9,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TotalText}" AutomationProperties.Name="Total (kg/m³)" />
                        </Grid>
                    </Border>

                    <WrapPanel Margin="8,8,0,0">
                        <Button Content="Agregar material" Command="{Binding AddMaterialCommand}" Margin="0,0,8,8"
                                b:ButtonIcon.Icon="{StaticResource Icon.Plus}"
                                ToolTip="{Binding AddMaterialToolTip}" ToolTipService.ShowOnDisabled="True" />
                        <Button Content="Calculadora" Command="{Binding CalculatorCommand}" Margin="0,0,8,8"
                                b:ButtonIcon.Icon="{StaticResource Icon.Calculator}"
                                ToolTip="Calcular la cantidad de un material como porcentaje de otro" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Materials]}" Margin="0,4,0,0" />
            </StackPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,8,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Style="{StaticResource DialogButtons}" Margin="0,12,0,0">
                <Button Content="{Binding CloseText}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding SaveCommand}" IsDefault="True"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Percentage calculator of the design form -->
    <DataTemplate DataType="{x:Type c:ReplacementCalculatorViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16"
                       Text="Calcula la cantidad del material de destino como un porcentaje de la cantidad del material de origen (por ejemplo, un aditivo como % del cemento)." />

            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Material de origen" />
                <ComboBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Origin}" DisplayMemberPath="DisplayText"
                          AutomationProperties.Name="Material de origen" b:FocusBehavior.FocusOnLoad="True" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Origin]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Material de destino" />
                <ComboBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Target}" DisplayMemberPath="DisplayText"
                          AutomationProperties.Name="Material de destino" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Target]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Porcentaje (%)" />
                <TextBox Text="{Binding Percentage, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                         Width="120" HorizontalAlignment="Left" TextAlignment="Right"
                         AutomationProperties.Name="Porcentaje" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Percentage]}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Destino = Origen × % / 100" />
                    <TextBlock Text="{Binding ResultText}" FontSize="{StaticResource FontSize.Section}" FontWeight="SemiBold"
                               AutomationProperties.Name="Resultado" />
                </StackPanel>
            </Border>

            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Aplicar" Command="{Binding ApplyCommand}" IsDefault="True"
                        ToolTip="Escribe el resultado en la cantidad del material de destino" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Client search (client / concrete provider of a test, client filter of the test list) -->
    <DataTemplate DataType="{x:Type c:ClientPickerViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,12" />

            <DockPanel Margin="0,0,0,8">
                <!-- Not when filtering the test list. The new client is chosen at once. -->
                <Button DockPanel.Dock="Right" Content="Nuevo cliente" Command="{Binding NewClientCommand}" Margin="8,0,0,0"
                        b:ButtonIcon.Icon="{StaticResource Icon.Plus}"
                        ToolTip="Crear el cliente (con el nombre buscado) y elegirlo"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}" />
                <TextBox Style="{StaticResource SearchBox}" Tag="Buscar por nombre, teléfono o correo…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Buscar" b:FocusBehavior.FocusOnLoad="True" />
            </DockPanel>

            <!-- Fixed height: the dialog scrolls, and an unbounded grid would load every row at once. -->
            <Grid Height="320">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          b:DataGridBehavior.OpenCommand="{Binding ChooseCommand}" AutomationProperties.Name="Clientes">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" MinWidth="160" />
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="120" />
                        <DataGridTextColumn Header="Dirección" Binding="{Binding Address}" Width="*" MinWidth="120" />
                    </DataGrid.Columns>
                </DataGrid>
                <ProgressBar VerticalAlignment="Top" Height="3" Margin="1,1,1,0" IsIndeterminate="{Binding IsLoading}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyText}"
                           Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVisibility}}" />
            </Grid>

            <DockPanel Margin="0,8,0,16" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource MutedText}" Text="{Binding StatusText}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Mostrar más" Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>

            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Elegir" Command="{Binding ChooseCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Test header: date, client, concrete provider, design, project, address -->
    <DataTemplate DataType="{x:Type t:TestEditorViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,16" />

            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <!-- Locked test (operator): view only. -->
            <Border Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}" Padding="10,8" Margin="0,0,0,14"
                    Visibility="{Binding LockWarning, Converter={StaticResource NotEmptyToVisibility}}">
                <DockPanel>
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Stroke="{StaticResource Brush.Warning}"
                          VerticalAlignment="Top" Margin="0,1,8,0" />
                    <TextBlock Text="{Binding LockWarning}" TextWrapping="Wrap" AutomationProperties.Name="Aviso" />
                </DockPanel>
            </Border>

            <StackPanel IsEnabled="{Binding CanEdit}">
                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fecha" />
                    <TextBox Style="{StaticResource DateBox}" Text="{Binding TestDate, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Fecha" ToolTip="dd/mm/aaaa" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[TestDate]}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Cliente" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Buscar…" Command="{Binding ChooseClientCommand}" Margin="8,0,0,0"
                                b:ButtonIcon.Icon="{StaticResource Icon.Search}" b:FocusBehavior.FocusOnLoad="True"
                                AutomationProperties.Name="Buscar cliente" />
                        <TextBox Text="{Binding ClientName, Mode=OneWay}" IsReadOnly="True" Focusable="False"
                                 AutomationProperties.Name="Cliente" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[ClientName]}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Proveedor del hormigón" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Buscar…" Command="{Binding ChooseConcreteProviderCommand}" Margin="8,0,0,0"
                                b:ButtonIcon.Icon="{StaticResource Icon.Search}" AutomationProperties.Name="Buscar proveedor del hormigón" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Igual que el cliente"
                                Command="{Binding UseClientAsProviderCommand}" Margin="8,0,0,0"
                                ToolTip="El cliente también suministra el hormigón" />
                        <TextBox Text="{Binding ConcreteProviderName, Mode=OneWay}" IsReadOnly="True" Focusable="False"
                                 AutomationProperties.Name="Proveedor del hormigón" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[ConcreteProviderName]}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Dosificación" />
                    <ComboBox ItemsSource="{Binding Designs}" SelectedValuePath="Id" DisplayMemberPath="Description"
                              SelectedValue="{Binding ConcreteDesignId}" AutomationProperties.Name="Dosificación" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[ConcreteDesignId]}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Proyecto / obra" />
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                             AutomationProperties.Name="Proyecto" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[ProjectName]}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Ubicación" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                             AutomationProperties.Name="Ubicación" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Address]}" />
                </StackPanel>
            </StackPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="{Binding CloseText}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding SaveCommand}" IsDefault="True"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--
        Probeta form (layout A): sections Identificación, Fechas (moldeo + edad = rotura), Medidas, Rotura with
        result tiles (densidad, resistencia, % del fck).
    -->
    <DataTemplate DataType="{x:Type t:SpecimenEditorViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,2" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding StartNote}"
                       Visibility="{Binding StartNote, Converter={StaticResource NotEmptyToVisibility}}" />
            <Border Height="14" />

            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}" Padding="10,8" Margin="0,0,0,14"
                    Visibility="{Binding Notice, Converter={StaticResource NotEmptyToVisibility}}">
                <DockPanel>
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Stroke="{StaticResource Brush.Warning}"
                          VerticalAlignment="Top" Margin="0,1,8,0" />
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.Name="Aviso" />
                </DockPanel>
            </Border>

            <!-- Identificación -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="IDENTIFICACIÓN" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Descripción" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" IsReadOnly="{Binding IsMeasurementsReadOnly}"
                             AutomationProperties.Name="Descripción" b:FocusBehavior.FocusOnLoad="True" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Code]}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Slump (cm)" />
                    <TextBox Text="{Binding Slump, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                             IsReadOnly="{Binding IsMeasurementsReadOnly}" AutomationProperties.Name="Slump" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Slump]}" />
                </StackPanel>
            </Grid>

            <!-- Fechas: moldeo + edad = rotura -->
            <Border Style="{StaticResource Tile}" Padding="14,10,14,0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="FECHAS" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource FormField}" Margin="0,0,8,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Moldeo" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource DateBox}" Width="140" Text="{Binding MoldDate, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding IsMeasurementsReadOnly}" AutomationProperties.Name="Fecha de moldeo" ToolTip="dd/mm/aaaa" />
                                <Button Content="Hoy" Command="{Binding TodayCommand}" Margin="4,0,0,0" Padding="8,5" ToolTip="Moldeada hoy" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[MoldDate]}" />
                        </StackPanel>
                        <TextBlock Text="+" Foreground="{StaticResource Brush.TextMuted}" Margin="0,26,8,0" FontSize="15" />
                        <StackPanel Style="{StaticResource FormField}" Margin="0,0,8,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Edad (días)" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding AgeDays, UpdateSourceTrigger=PropertyChanged}" Width="52" MaxLength="4" TextAlignment="Right"
                                         IsReadOnly="{Binding IsMeasurementsReadOnly}" AutomationProperties.Name="Edad en días"
                                         ToolTip="Con la fecha de moldeo calcula la fecha de rotura" />
                                <Button Content="7" Command="{Binding AgeCommand}" CommandParameter="7" Margin="4,0,0,0" Padding="9,5" MinWidth="34"
                                        ToolTip="Rotura a los 7 días" AutomationProperties.Name="7 días" />
                                <Button Content="14" Command="{Binding AgeCommand}" CommandParameter="14" Margin="4,0,0,0" Padding="9,5" MinWidth="34"
                                        ToolTip="Rotura a los 14 días" AutomationProperties.Name="14 días" />
                                <Button Content="28" Command="{Binding AgeCommand}" CommandParameter="28" Margin="4,0,0,0" Padding="9,5" MinWidth="34"
                                        ToolTip="Rotura a los 28 días" AutomationProperties.Name="28 días" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[AgeDays]}" />
                        </StackPanel>
                        <TextBlock Text="=" Foreground="{StaticResource Brush.TextMuted}" Margin="0,26,8,0" FontSize="15" />
                        <StackPanel Style="{StaticResource FormField}" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rotura" />
                            <TextBox Style="{StaticResource DateBox}" Width="140" Text="{Binding RuptureDate, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsMeasurementsReadOnly}" AutomationProperties.Name="Fecha de rotura" ToolTip="dd/mm/aaaa" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[RuptureDate]}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Medidas -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="MEDIDAS" />
            <UniformGrid Columns="3" Margin="0,0,0,4">
                <StackPanel Style="{StaticResource FormField}" Margin="0,0,12,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Diámetro (cm)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AverageDiameterCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Calculator}"
                                Margin="4,0,0,0" ToolTip="Promedio de dos lecturas" AutomationProperties.Name="Promedio del diámetro" />
                        <TextBox Text="{Binding DiameterCm, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                                 IsReadOnly="{Binding IsMeasurementsReadOnly}" AutomationProperties.Name="Diámetro" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[DiameterCm]}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FormField}" Margin="0,0,12,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Altura (cm)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding AverageHeightCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Calculator}"
                                Margin="4,0,0,0" ToolTip="Promedio de dos lecturas" AutomationProperties.Name="Promedio de la altura" />
                        <TextBox Text="{Binding HeightCm, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                                 IsReadOnly="{Binding IsMeasurementsReadOnly}" AutomationProperties.Name="Altura" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[HeightCm]}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FormField}" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Peso (kg)" />
                    <TextBox Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                             IsReadOnly="{Binding IsMeasurementsReadOnly}" AutomationProperties.Name="Peso" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[WeightKg]}" />
                </StackPanel>
            </UniformGrid>

            <!-- Rotura + results -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="ROTURA" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Rotura (t)" />
                    <TextBox Text="{Binding RuptureLoadTon, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                             IsReadOnly="{Binding IsLoadReadOnly}" AutomationProperties.Name="Rotura en toneladas"
                             b:FocusBehavior.FocusOnLoad="{Binding IsMeasurementsReadOnly}" ToolTip="Vacío hasta romper la probeta" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[RuptureLoadTon]}" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Tile}" VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="Densidad" />
                        <TextBlock Style="{StaticResource TileValue}" Text="{Binding DensityText}" AutomationProperties.Name="Densidad" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Tile}" VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="Resistencia" />
                        <TextBlock Style="{StaticResource TileValue}" Text="{Binding StrengthValueText}" AutomationProperties.Name="Resistencia" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Tile}" VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="{Binding PercentLabel}" />
                        <TextBlock Style="{StaticResource TileValue}" Text="{Binding PercentText}" AutomationProperties.Name="Porcentaje del fck" />
                    </StackPanel>
                </Border>
            </Grid>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="{Binding CloseText}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding SaveCommand}" IsDefault="True"
                        Visibility="{Binding CanSave, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Registrar rotura (layout C): the probeta read-only, one large field for the load, live result -->
    <DataTemplate DataType="{x:Type t:RuptureEntryViewModel}">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" x:Name="StatusChip">
                    <TextBlock x:Name="StatusChipText" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.Small}"
                               AutomationProperties.Name="Estado de la probeta" />
                </Border>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>

            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Control}" Padding="10,8" Margin="0,0,0,14"
                    Visibility="{Binding Notice, Converter={StaticResource NotEmptyToVisibility}}">
                <DockPanel>
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Stroke="{StaticResource Brush.Warning}"
                          VerticalAlignment="Top" Margin="0,1,8,0" />
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.Name="Aviso" />
                </DockPanel>
            </Border>

            <!-- What is being broken -->
            <Border Style="{StaticResource Tile}" Padding="14,10" Margin="0,0,0,16">
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,8"><TextBlock Style="{StaticResource TileLabel}" Text="Descripción" /><TextBlock Text="{Binding Specimen.Code}" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel Margin="0,0,8,8"><TextBlock Style="{StaticResource TileLabel}" Text="Moldeo" /><TextBlock Text="{Binding MoldDateText}" /></StackPanel>
                    <StackPanel Margin="0,0,0,8"><TextBlock Style="{StaticResource TileLabel}" Text="Edad" /><TextBlock Text="{Binding AgeText}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource TileLabel}" Text="Diámetro" /><TextBlock Text="{Binding Specimen.DiameterCm, StringFormat={}{0:0.00} cm}" /></StackPanel>
                    <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource TileLabel}" Text="Altura" /><TextBlock Text="{Binding Specimen.HeightCm, StringFormat={}{0:0.00} cm}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource TileLabel}" Text="Peso" /><TextBlock Text="{Binding Specimen.WeightKg, StringFormat={}{0:0.000} kg}" /></StackPanel>
                </UniformGrid>
            </Border>

            <!-- The one thing to type -->
            <TextBlock Text="Rotura (toneladas)" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox Text="{Binding RuptureLoadTon, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"
                     FontSize="22" TextAlignment="Right" Padding="10,6" IsReadOnly="{Binding CanSave, Converter={StaticResource InverseBool}}"
                     AutomationProperties.Name="Rotura en toneladas" b:FocusBehavior.FocusOnLoad="True" />
            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[RuptureLoadTon]}" />
            <Border Height="12" />

            <UniformGrid Columns="2" Margin="0,0,0,12">
                <Border Style="{StaticResource Tile}" Margin="0,0,12,0" Padding="14,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="Resistencia" />
                        <TextBlock Style="{StaticResource TileValueLarge}" AutomationProperties.Name="Resistencia">
                            <Run Text="{Binding StrengthText, Mode=OneWay}" />
                            <Run Text="kg/cm²" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Brush.TextMuted}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Padding="14,8" Background="{StaticResource Brush.SuccessSoft}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="{Binding PercentLabel}" Foreground="{StaticResource Brush.Success}" />
                        <TextBlock Style="{StaticResource TileValueLarge}" Text="{Binding PercentText}" Foreground="{StaticResource Brush.Success}"
                                   AutomationProperties.Name="Porcentaje del fck" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16"
                        Visibility="{Binding LockNote, Converter={StaticResource NotEmptyToVisibility}}">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Stroke="{StaticResource Brush.TextMuted}"
                      Width="14" Height="14" Margin="0,0,6,0" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding LockNote}" FontSize="{StaticResource FontSize.Small}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <WrapPanel HorizontalAlignment="Right">
                <Button Content="{Binding CloseText}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{Binding NextText}" Command="{Binding SaveAndNextCommand}" Margin="0,0,8,0"
                        ToolTip="Guarda y abre la siguiente probeta para romper"
                        Visibility="{Binding HasNext, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding SaveCommand}" IsDefault="True"
                        Visibility="{Binding CanSave, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Overdue">
                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource Brush.RowOverdue}" />
                <Setter TargetName="StatusChipText" Property="Foreground" Value="{StaticResource Brush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="DueSoon">
                <Setter TargetName="StatusChip" Property="Background" Value="{StaticResource Brush.RowDueSoon}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Average of two readings (diameter / height) -->
    <DataTemplate DataType="{x:Type t:AverageCalculatorViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16"
                       Text="Mida dos veces (por ejemplo, en cruz) y se usa el promedio." />
            <WrapPanel>
                <StackPanel Style="{StaticResource FormField}" Width="160" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Lectura 1" />
                    <TextBox Text="{Binding Reading1, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                             AutomationProperties.Name="Lectura 1" b:FocusBehavior.FocusOnLoad="True" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Reading1]}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FormField}" Width="160">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Lectura 2" />
                    <TextBox Text="{Binding Reading2, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                             AutomationProperties.Name="Lectura 2" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Reading2]}" />
                </StackPanel>
            </WrapPanel>
            <TextBlock Margin="0,0,0,20">
                <Run Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding Label, Mode=OneWay}" />
                <Run Foreground="{StaticResource Brush.TextSecondary}" Text="promedio:" />
                <Run FontWeight="SemiBold" Text="{Binding ResultText, Mode=OneWay}" />
            </TextBlock>
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Usar promedio" Command="{Binding ApplyCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Specimen filter: mold dates and/or probeta numbers -->
    <DataTemplate DataType="{x:Type t:SpecimenFilterViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,16" />
            <WrapPanel>
                <StackPanel Style="{StaticResource FormField}" Width="170" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Moldeo desde" />
                    <TextBox Style="{StaticResource DateBox}" Text="{Binding MoldDateFrom, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Moldeo desde" b:FocusBehavior.FocusOnLoad="True" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[MoldDateFrom]}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FormField}" Width="170">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Moldeo hasta" />
                    <TextBox Style="{StaticResource DateBox}" Text="{Binding MoldDateTo, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Moldeo hasta" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[MoldDateTo]}" />
                </StackPanel>
            </WrapPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Probetas (Nº)" />
                <TextBox Text="{Binding IdRanges, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Números de probeta" />
                <TextBlock Style="{StaticResource MutedText}" Text="Ejemplo: 1-5, 8, 10-12. Vacío = todas." Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[IdRanges]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Filtrar" Command="{Binding ApplyCommand}" IsDefault="True"
                        b:ButtonIcon.Icon="{StaticResource Icon.Filter}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Administrator unlocks a test for the signed-in user -->
    <DataTemplate DataType="{x:Type t:AdminUnlockViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Explanation}" Margin="0,0,0,16" />
            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Usuario administrador" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Usuario administrador"
                         b:FocusBehavior.FocusOnLoad="True" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[UserName]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Contraseña" />
                <PasswordBox b:PasswordBoxBinding.Password="{Binding Password}" AutomationProperties.Name="Contraseña" />
            </StackPanel>
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Desbloquear" Command="{Binding SaveCommand}" IsDefault="True"
                        b:ButtonIcon.Icon="{StaticResource Icon.Unlock}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Probetas para romper (after login), grouped by ensayo; layout D -->
    <DataTemplate DataType="{x:Type t:DueSpecimensViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Warning}" Stroke="{StaticResource Brush.Warning}" Margin="0,0,8,0" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Heading}" Margin="0" />
            </StackPanel>

            <WrapPanel Margin="0,0,0,12">
                <Border Style="{StaticResource Chip}" Background="{StaticResource Brush.RowOverdue}" BorderThickness="0" Margin="0,0,8,0"
                        Visibility="{Binding HasOverdue, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding OverdueText}" Foreground="{StaticResource Brush.Error}" FontWeight="SemiBold" />
                </Border>
                <Border Style="{StaticResource Chip}" Background="{StaticResource Brush.RowDueSoon}" BorderThickness="0" Margin="0,0,8,0"
                        Visibility="{Binding HasToday, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding TodayText}" FontWeight="SemiBold" />
                </Border>
                <Border Style="{StaticResource Chip}" Margin="0,0,8,0"
                        Visibility="{Binding HasTomorrow, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding TomorrowText}" FontWeight="SemiBold" />
                </Border>
            </WrapPanel>

            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Margin="0,0,0,14">
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" AutomationProperties.Name="Ensayos con probetas para romper">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Background="{StaticResource Brush.SurfaceMuted}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                                            Padding="12,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Abrir ensayo" Command="{Binding OpenCommand}" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{Binding Heading, StringFormat=Abrir {0}}" />
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Row" Padding="12,6" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Id, StringFormat=Nº {0}}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RuptureDate, StringFormat=Rotura {0:dd/MM}}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding AgeDays, StringFormat={}{0} días}" />
                                                        <TextBlock Grid.Column="3" Foreground="{StaticResource Brush.TextSecondary}"
                                                                   Text="{Binding MoldDate, StringFormat=Moldeo {0:dd/MM/yyyy}}" />
                                                        <TextBlock x:Name="Status" Grid.Column="4" Text="{Binding StatusText}" FontWeight="SemiBold" TextAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding RowStatus}" Value="Overdue">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.RowOverdue}" />
                                                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Brush.Error}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RowStatus}" Value="DueSoon">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.RowDueSoon}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Cerrar" Command="{Binding CloseCommand}"
                        IsDefault="True" IsCancel="True" b:FocusBehavior.FocusOnLoad="True" />
                <CheckBox Content="No volver a mostrar hoy en este equipo" IsChecked="{Binding HideToday}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- New / edit user (Configuración → Usuarios) -->
    <DataTemplate DataType="{x:Type st:UserEditorViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,16" />
            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Usuario (para iniciar sesión, sin espacios)" />
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" AutomationProperties.Name="Usuario"
                         b:FocusBehavior.FocusOnLoad="True" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[UserName]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre completo" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Nombre completo" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[FullName]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Rol" />
                <ComboBox ItemsSource="{Binding RoleOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          SelectedValue="{Binding Role}" IsEnabled="{Binding CanChangeRole}" AutomationProperties.Name="Rol"
                          ToolTip="Operador: crea y modifica datos. Administrador: además archiva, desbloquea ensayos y administra usuarios." />
                <TextBlock Style="{StaticResource MutedText}" Text="No puede cambiar su propio rol." Margin="0,4,0,0"
                           Visibility="{Binding IsSelf, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Role]}" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Contraseña inicial" />
                    <PasswordBox b:PasswordBoxBinding.Password="{Binding Password}" AutomationProperties.Name="Contraseña inicial" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Password]}" />
                </StackPanel>
                <StackPanel Style="{StaticResource FormField}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Repetir contraseña" />
                    <PasswordBox b:PasswordBoxBinding.Password="{Binding ConfirmPassword}" AutomationProperties.Name="Repetir contraseña" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[ConfirmPassword]}" />
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding PasswordRule}" Margin="0,0,0,12" />
            </StackPanel>
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Guardar" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Temporary password for another user -->
    <DataTemplate DataType="{x:Type st:ResetPasswordViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Explanation}" Margin="0,0,0,16" />
            <Border Style="{StaticResource MessageBanner}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Contraseña temporal" />
                <PasswordBox b:PasswordBoxBinding.Password="{Binding Password}" AutomationProperties.Name="Contraseña temporal"
                             b:FocusBehavior.FocusOnLoad="True" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[Password]}" />
            </StackPanel>
            <StackPanel Style="{StaticResource FormField}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Repetir contraseña" />
                <PasswordBox b:PasswordBoxBinding.Password="{Binding ConfirmPassword}" AutomationProperties.Name="Repetir contraseña" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[ConfirmPassword]}" />
            </StackPanel>
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Style="{StaticResource DialogButtons}">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Restablecer" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
