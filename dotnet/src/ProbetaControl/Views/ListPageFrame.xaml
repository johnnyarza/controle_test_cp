<!--
    Shared frame of every list page (binds to ListPageViewModel): title, toolbar, loading bar,
    empty-state text, "Mostrando X de Y" and "Mostrar más". The page's DataGrid goes inside:
        <ContentControl Style="{StaticResource ListPageFrame}"> <DataGrid … /> </ContentControl>
    and uses RowStyle="{StaticResource ListPageDataGridRow}" for the right-click menu.
    Page-specific filters go in the ContentControl's Tag; they appear under the toolbar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors">

    <!--
        Right-click menu of a list row (right-click selects the row first). A context menu is outside the
        visual tree, so it reaches the page view model through the row's Tag (set by ListPageDataGridRow).
    -->
    <ContextMenu x:Key="ListRowMenu" x:Shared="False"
                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="{Binding EditText}" FontWeight="SemiBold" Command="{Binding EditCommand}"
                  b:ButtonIcon.Icon="{StaticResource Icon.Edit}" />
        <MenuItem Header="Duplicar" Command="{Binding DuplicateCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Copy}"
                  Visibility="{Binding SupportsDuplicate, Converter={StaticResource BoolToVisibility}}" />
        <MenuItem Header="{Binding ArchiveText}" Command="{Binding ToggleArchiveCommand}"
                  ToolTip="{Binding ArchiveToolTip}" ToolTipService.ShowOnDisabled="True">
            <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="b:ButtonIcon.Icon" Value="{StaticResource Icon.Archive}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedIsArchived}" Value="True">
                            <Setter Property="b:ButtonIcon.Icon" Value="{StaticResource Icon.Restore}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </MenuItem.Style>
        </MenuItem>
    </ContextMenu>

    <!-- Row style of list pages: archived rows in grey + the right-click menu. -->
    <Style x:Key="ListPageDataGridRow" TargetType="DataGridRow" BasedOn="{StaticResource ArchivableDataGridRow}">
        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        <Setter Property="ContextMenu" Value="{StaticResource ListRowMenu}" />
    </Style>

    <Style x:Key="ListPageFrame" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Title}" />

                        <WrapPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                            <TextBox Style="{StaticResource SearchBox}" Width="280" Margin="0,0,8,8" Tag="Buscar…"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Buscar" b:FocusBehavior.FocusOnLoad="True" />
                            <CheckBox Content="Mostrar archivados" IsChecked="{Binding IncludeArchived}"
                                      VerticalAlignment="Center" Margin="4,0,16,8" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Nuevo" Command="{Binding NewCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Plus}" Margin="0,0,8,8" />
                            <Button Content="{Binding EditText}" Command="{Binding EditCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Edit}" Margin="0,0,8,8" />
                            <Button Content="Duplicar" Command="{Binding DuplicateCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Copy}" Margin="0,0,8,8"
                                    ToolTip="{Binding DuplicateToolTip}"
                                    Visibility="{Binding SupportsDuplicate, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding ArchiveText}" Command="{Binding ToggleArchiveCommand}" Margin="0,0,8,8"
                                    ToolTip="{Binding ArchiveToolTip}" ToolTipService.ShowOnDisabled="True">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="b:ButtonIcon.Icon" Value="{StaticResource Icon.Archive}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIsArchived}" Value="True">
                                                <Setter Property="b:ButtonIcon.Icon" Value="{StaticResource Icon.Restore}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Refresh}" Margin="0,0,8,8"
                                    ToolTip="Actualizar (F5)" AutomationProperties.Name="Actualizar" />
                        </WrapPanel>

                        <!-- Optional page filters (ContentControl Tag), under the toolbar. -->
                        <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Tag}" />

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource MutedText}" Text="{Binding StatusText}"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Mostrar más" Command="{Binding LoadMoreCommand}"
                                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </DockPanel>

                        <Grid>
                            <ContentPresenter />
                            <ProgressBar VerticalAlignment="Top" Height="3" Margin="1,1,1,0" IsIndeterminate="{Binding IsLoading}"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyText}"
                                       Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
