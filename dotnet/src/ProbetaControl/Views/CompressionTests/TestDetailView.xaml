<UserControl x:Class="ProbetaControl.Views.CompressionTests.TestDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors"
             xmlns:v="clr-namespace:ProbetaControl.Views">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewSpecimenCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RecordRuptureCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportExcelCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LabelsCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FilterCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,4,0" />
        </Style>
        <!-- "Cliente Constructora Andina": muted label, value in bold, one line each. -->
        <Style x:Key="InfoLabel" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style x:Key="InfoValue" TargetType="Run">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="InfoItem" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,24,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Right-click menu of a probeta row; reaches the page through the row's Tag. -->
        <ContextMenu x:Key="SpecimenMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Registrar rotura" FontWeight="SemiBold" Command="{Binding RecordRuptureCommand}"
                      InputGestureText="Ctrl+R" b:ButtonIcon.Icon="{StaticResource Icon.Specimen}" />
            <MenuItem Header="Editar" Command="{Binding EditSpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Edit}" />
            <MenuItem Header="Copiar" Command="{Binding CopySpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Copy}" />
            <MenuItem Header="Imprimir etiqueta…" Command="{Binding SpecimenLabelCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Qr}"
                      ToolTip="La etiqueta QR de esta probeta, por ejemplo para reponer una dañada" />
            <MenuItem Header="{Binding ArchiveText}" Command="{Binding ToggleArchiveSpecimenCommand}"
                      ToolTip="{Binding ArchiveToolTip}" ToolTipService.ShowOnDisabled="True"
                      b:ButtonIcon.Icon="{StaticResource Icon.Archive}" />
        </ContextMenu>

        <Style x:Key="SpecimenRow" TargetType="DataGridRow" BasedOn="{StaticResource StatusDataGridRow}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Setter Property="ContextMenu" Value="{StaticResource SpecimenMenu}" />
        </Style>
        <!--
            The panel under "Filtrar" (SpecimenFilterPanelViewModel; layout D chosen by the user): Estado, Edad and
            Nº o descripción on the left; the ensayo's mold days and a date range (moldeo or rotura) on the right.
            Nothing changes until "Mostrar N probetas" (or Enter); Esc or a click outside closes it.
        -->
        <DataTemplate x:Key="SpecimenFilterPanelTemplate">
            <Border Margin="0,2,8,8" Width="600" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="Filtrar probetas">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="315" Opacity="0.18" />
                </Border.Effect>
                <Border.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ApplyCommand}" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid Margin="16,14,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Estado" />
                            <ItemsControl ItemsSource="{Binding States}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton GroupName="FilterState" IsChecked="{Binding IsChecked}" Content="{Binding Text}"
                                                         VerticalContentAlignment="Center" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="{Binding Count}" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Edad" Margin="0,12,0,4" />
                            <WrapPanel>
                                <ToggleButton Style="{StaticResource FilterPill}" Content="Todas" IsChecked="{Binding AllAges, Mode=OneWay}"
                                              Command="{Binding AllAgesCommand}" AutomationProperties.Name="Todas las edades" />
                                <ItemsControl ItemsSource="{Binding Ages}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource FilterPill}" IsChecked="{Binding IsChecked}" Content="{Binding Text}"
                                                          ToolTip="{Binding Count}" ToolTipService.ShowDuration="4000"
                                                          AutomationProperties.Name="{Binding Text, StringFormat=Edad {0}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nº o descripción" Margin="0,8,0,4" />
                            <TextBox Text="{Binding NumbersOrText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nº o descripción" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="{StaticResource FontSize.Small}" Text="{Binding NumbersOrTextHint}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Días de moldeo de este ensayo" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl ItemsSource="{Binding MoldDays}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Text}"
                                                          AutomationProperties.Name="{Binding Text, StringFormat=Moldeo {0}}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="{Binding Detail}" Margin="8,0"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" Text="{Binding Count}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Entre fechas de" VerticalAlignment="Center" Margin="0,0,8,6" />
                                        <RadioButton Style="{StaticResource FilterPillRadio}" GroupName="FilterRange" Content="Moldeo"
                                                     IsChecked="{Binding RangeOnMold}" AutomationProperties.Name="Fechas de moldeo" />
                                        <RadioButton Style="{StaticResource FilterPillRadio}" GroupName="FilterRange" Content="Rotura"
                                                     IsChecked="{Binding RangeOnRupture}" AutomationProperties.Name="Fechas de rotura" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Desde" />
                                            <TextBox Style="{StaticResource DateBox}" Width="130" Text="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Desde" />
                                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[DateFrom]}" MaxWidth="130" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Hasta" />
                                            <TextBox Style="{StaticResource DateBox}" Width="130" Text="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Hasta" />
                                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[DateTo]}" MaxWidth="130" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="-8,4,0,0">
                                        <Button Style="{StaticResource SubtleButton}" Content="Hoy" Command="{Binding TodayCommand}" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Esta semana" Command="{Binding ThisWeekCommand}" />
                                        <Button Style="{StaticResource SubtleButton}" Content="Próx. 7 días" Command="{Binding NextSevenDaysCommand}" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="{StaticResource FontSize.Small}" Text="Una fecha vacía = sin límite."
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,10" Margin="0,8,0,0">
                        <DockPanel>
                            <CheckBox Content="Incluir archivadas" IsChecked="{Binding IncludeArchived}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SubtleButton}" Content="Limpiar" Command="{Binding ClearCommand}" Margin="0,0,8,0"
                                        ToolTip="Todas las opciones como al principio" />
                                <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"
                                        b:ButtonIcon.Icon="{StaticResource Icon.Filter}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Layout B: one-line header, indicator tiles, then the full-width probetas table with its toolbar.
        The table takes the free height; below about 430 px the whole page scrolls instead of squeezing it
        (an unbounded grid inside a ScrollViewer would lose virtualization).
    -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid MinHeight="430" Height="{Binding ViewportHeight, ElementName=PageScroll}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title row; header actions on the right -->
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="Ensayos" Command="{Binding BackCommand}"
                        b:ButtonIcon.Icon="{StaticResource Icon.Back}" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="Volver a la lista de ensayos (Alt+←)" AutomationProperties.Name="Volver a Ensayos" />
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Imprimir" Command="{Binding PrintCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Print}"
                            Margin="8,0,0,0" ToolTip="{Binding PrintToolTip}" />
                    <Button Content="Excel" Command="{Binding ExportExcelCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Sheet}"
                            Margin="8,0,0,0" ToolTip="{Binding ExportExcelToolTip}" AutomationProperties.Name="Exportar a Excel" />
                    <Button Content="Etiquetas" Command="{Binding LabelsCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Qr}"
                            Margin="8,0,0,0" ToolTip="{Binding LabelsToolTip}" AutomationProperties.Name="Etiquetas QR" />
                    <Button Content="Editar datos" Command="{Binding EditHeaderCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Edit}"
                            Margin="8,0,0,0" ToolTip="Fecha, cliente, proveedor, dosificación, proyecto y ubicación" />
                    <Button Content="Desbloquear…" Command="{Binding UnlockCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Unlock}"
                            Margin="8,0,0,0" ToolTip="Un administrador ingresa su usuario y contraseña"
                            Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Bloquear" Command="{Binding LockCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Lock}"
                            Margin="8,0,0,0" ToolTip="Volver a bloquear el ensayo (por ejemplo, antes de dejar el equipo)"
                            Visibility="{Binding ShowLock, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,10,0" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,12,0" Text="{Binding Test.ProjectName}" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" FontWeight="Normal" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" ToolTip="{Binding LockText}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Stroke="{StaticResource Brush.TextSecondary}"
                                  Width="14" Height="14" Margin="0,0,4,0"
                                  Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVisibility}}" />
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Unlock}" Stroke="{StaticResource Brush.Success}"
                                  Width="14" Height="14" Margin="0,0,4,0"
                                  Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding LockChipText}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Small}"
                                       AutomationProperties.Name="Estado del bloqueo" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}"
                            Visibility="{Binding Test.IsArchived, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <TextBlock Text="Archivado" Foreground="{StaticResource Brush.TextMuted}" FontSize="{StaticResource FontSize.Small}" />
                    </Border>
                </WrapPanel>
            </DockPanel>

            <!-- One-line header + indicator tiles -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Fecha" /> <Run Style="{StaticResource InfoValue}" Text="{Binding TestDateText, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Cliente" /> <Run Style="{StaticResource InfoValue}" Text="{Binding Test.ClientName, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Proveedor" /> <Run Style="{StaticResource InfoValue}" Text="{Binding Test.ConcreteProviderName, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Dosificación" /> <Run Style="{StaticResource InfoValue}" Text="{Binding DesignText, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Ubicación" /> <Run Style="{StaticResource InfoValue}" Text="{Binding Test.Address, Mode=OneWay}" /></TextBlock>
                </WrapPanel>

                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Tile}" Margin="0,0,12,0" Padding="14,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Probetas" />
                            <TextBlock Style="{StaticResource TileValueLarge}" Text="{v:NumberBinding ActiveCount, Digits=0}" AutomationProperties.Name="Probetas" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="0,0,12,0" Padding="14,8" Background="{StaticResource Brush.ErrorSoft}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Para romper (hoy o antes)" Foreground="{StaticResource Brush.Error}" />
                            <TextBlock Style="{StaticResource TileValueLarge}" Text="{v:NumberBinding DueCount, Digits=0}" Foreground="{StaticResource Brush.Error}"
                                       AutomationProperties.Name="Probetas para romper" ToolTip="{Binding DueText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="0,0,12,0" Padding="14,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Rotas" />
                            <TextBlock Style="{StaticResource TileValueLarge}" AutomationProperties.Name="Rotas">
                                <Run Text="{v:NumberBinding TestedCount, Digits=0}" />
                                <Run Text="{Binding TestedText, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Brush.TextMuted}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Padding="14,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Resistencia media (kg/cm²)" />
                            <TextBlock Style="{StaticResource TileValueLarge}" AutomationProperties.Name="Resistencia media">
                                <Run Text="{Binding AverageStrengthText, Mode=OneWay}" />
                                <Run Text="{Binding AveragePercentText, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Brush.Success}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- Probetas: toolbar, table and legend in one card -->
            <Border Grid.Row="3" MinHeight="180" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,12,0">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button x:Name="FilterButton" Content="{Binding FilterButtonText}" Command="{Binding FilterCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Filter}" Margin="8,0,0,8"
                                    ToolTip="Por estado, fechas, edad, número o descripción (Ctrl+F)" AutomationProperties.Name="Filtrar">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowFilterChips}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.PrimarySoft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Popup IsOpen="{Binding IsFilterOpen, Mode=TwoWay}" StaysOpen="True" AllowsTransparency="True"
                                   b:PopupPanel.Opener="{Binding ElementName=FilterButton}">
                                <ContentControl Content="{Binding FilterPanel}" ContentTemplate="{StaticResource SpecimenFilterPanelTemplate}"
                                                Focusable="False" />
                            </Popup>
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Refresh}" Margin="8,0,0,8"
                                    ToolTip="Actualizar (F5)" AutomationProperties.Name="Actualizar" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Probetas" Margin="0,0,12,8" VerticalAlignment="Center" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Nueva probeta" Command="{Binding NewSpecimenCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Plus}" Margin="0,0,8,8"
                                    ToolTip="{Binding NewSpecimenToolTip}" ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Registrar rotura" Command="{Binding RecordRuptureCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Specimen}"
                                    Margin="0,0,8,8" ToolTip="Rotura de la probeta seleccionada (Ctrl+R; también doble clic)" />
                            <Button Content="Editar" Command="{Binding EditSpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Edit}" Margin="0,0,8,8"
                                    ToolTip="Todos los datos de la probeta" />
                            <Button Content="Copiar" Command="{Binding CopySpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Copy}" Margin="0,0,8,8"
                                    ToolTip="Nueva probeta con las medidas de la seleccionada" />
                            <Button Content="{Binding ArchiveText}" Command="{Binding ToggleArchiveSpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Archive}"
                                    Margin="0,0,8,8" ToolTip="{Binding ArchiveToolTip}" ToolTipService.ShowOnDisabled="True" />
                        </WrapPanel>
                    </DockPanel>

                    <!-- Active filter: "Mostrando 3 de 12:" and one removable chip per part -->
                    <WrapPanel DockPanel.Dock="Top" Margin="12,0,12,6"
                               Visibility="{Binding ShowFilterChips, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding FilterSummary}" VerticalAlignment="Center" Margin="0,0,8,4" />
                        <ItemsControl ItemsSource="{Binding FilterChips}" ItemTemplate="{StaticResource FilterTagTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button Style="{StaticResource SubtleButton}" Content="Quitar todo" Command="{Binding ClearFilterCommand}"
                                b:ButtonIcon.Icon="{StaticResource Icon.FilterOff}" Margin="0,0,0,4" />
                    </WrapPanel>

                    <!-- Count + colour legend -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="12,6,12,8">
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding CountText}" Margin="0,0,24,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Swatch}" Background="{StaticResource Brush.RowOverdue}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Retrasada" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Swatch}" Background="{StaticResource Brush.RowDueSoon}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Romper hoy o mañana" VerticalAlignment="Center" />
                    </WrapPanel>

                    <Grid>
                        <!-- Focused when the page opens, so the shortcuts (Ctrl+N, Ctrl+P…) work before a probeta is selected. -->
                        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0,1"
                                  b:FocusBehavior.FocusOnLoad="True"
                                  RowStyle="{StaticResource SpecimenRow}"
                                  b:DataGridBehavior.OpenCommand="{Binding OpenSpecimenCommand}"
                                  AutomationProperties.Name="Probetas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" MinWidth="50" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Code}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="Slump (cm)" Binding="{v:NumberBinding Slump, Digits=2}" Width="88" MinWidth="88" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Moldeo" Binding="{Binding MoldDate, StringFormat=dd/MM/yyyy}" Width="90" MinWidth="90" />
                                <DataGridTextColumn Header="Rotura" Binding="{Binding RuptureDate, StringFormat=dd/MM/yyyy}" Width="90" MinWidth="90" />
                                <DataGridTextColumn Header="Edad" Binding="{Binding AgeDays}" Width="52" MinWidth="52" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Ø (cm)" Binding="{v:NumberBinding DiameterCm, Digits=2}" Width="68" MinWidth="68" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Altura (cm)" Binding="{v:NumberBinding HeightCm, Digits=2}" Width="88" MinWidth="88" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Peso (kg)" Binding="{v:NumberBinding WeightKg, Digits=3}" Width="80" MinWidth="80" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Densidad (kg/m³)" Binding="{v:NumberBinding DensityKgPerM3, Digits=2}" Width="124" MinWidth="124" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Rotura (t)" Binding="{v:NumberBinding RuptureLoadTon, Digits=2}" Width="80" MinWidth="80" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Resist. (kg/cm²)" Binding="{v:NumberBinding StrengthKgPerCm2, Digits=2}" Width="118" MinWidth="118" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="% fck" Binding="{v:NumberBinding PercentOfFck, Digits=0, Unit=%, TargetNullValue=''}" Width="60" MinWidth="60" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="82" MinWidth="82" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ProgressBar VerticalAlignment="Top" Height="3" Margin="1,1,1,0" IsIndeterminate="{Binding IsLoading}"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyText}"
                                   Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
