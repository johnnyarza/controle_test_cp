<UserControl x:Class="ProbetaControl.Views.CompressionTests.TestDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewSpecimenCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RecordRuptureCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportExcelCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,4,0" />
        </Style>
        <!-- "Cliente Constructora Andina": muted label, value in bold, one line each. -->
        <Style x:Key="InfoLabel" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style x:Key="InfoValue" TargetType="Run">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="InfoItem" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,24,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Right-click menu of a probeta row; reaches the page through the row's Tag. -->
        <ContextMenu x:Key="SpecimenMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Registrar rotura" FontWeight="SemiBold" Command="{Binding RecordRuptureCommand}"
                      InputGestureText="Ctrl+R" b:ButtonIcon.Icon="{StaticResource Icon.Specimen}" />
            <MenuItem Header="Editar" Command="{Binding EditSpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Edit}" />
            <MenuItem Header="Copiar" Command="{Binding CopySpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Copy}" />
            <MenuItem Header="{Binding ArchiveText}" Command="{Binding ToggleArchiveSpecimenCommand}"
                      ToolTip="{Binding ArchiveToolTip}" ToolTipService.ShowOnDisabled="True"
                      b:ButtonIcon.Icon="{StaticResource Icon.Archive}" />
        </ContextMenu>

        <Style x:Key="SpecimenRow" TargetType="DataGridRow" BasedOn="{StaticResource StatusDataGridRow}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Setter Property="ContextMenu" Value="{StaticResource SpecimenMenu}" />
        </Style>
    </UserControl.Resources>

    <!--
        Layout B: one-line header, indicator tiles, then the full-width probetas table with its toolbar.
        The table takes the free height; below about 430 px the whole page scrolls instead of squeezing it
        (an unbounded grid inside a ScrollViewer would lose virtualization).
    -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid MinHeight="430" Height="{Binding ViewportHeight, ElementName=PageScroll}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title row; header actions on the right -->
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="Ensayos" Command="{Binding BackCommand}"
                        b:ButtonIcon.Icon="{StaticResource Icon.Back}" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="Volver a la lista de ensayos (Alt+←)" AutomationProperties.Name="Volver a Ensayos" />
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Imprimir" Command="{Binding PrintCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Print}"
                            Margin="8,0,0,0" ToolTip="{Binding PrintToolTip}" />
                    <Button Content="Excel" Command="{Binding ExportExcelCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Sheet}"
                            Margin="8,0,0,0" ToolTip="{Binding ExportExcelToolTip}" AutomationProperties.Name="Exportar a Excel" />
                    <Button Content="Editar datos" Command="{Binding EditHeaderCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Edit}"
                            Margin="8,0,0,0" ToolTip="Fecha, cliente, proveedor, dosificación, proyecto y ubicación" />
                    <Button Content="Desbloquear…" Command="{Binding UnlockCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Unlock}"
                            Margin="8,0,0,0" ToolTip="Un administrador ingresa su usuario y contraseña"
                            Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Bloquear" Command="{Binding LockCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Lock}"
                            Margin="8,0,0,0" ToolTip="Volver a bloquear el ensayo (por ejemplo, antes de dejar el equipo)"
                            Visibility="{Binding ShowLock, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,10,0" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,12,0" Text="{Binding Test.ProjectName}" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" FontWeight="Normal" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" ToolTip="{Binding LockText}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Stroke="{StaticResource Brush.TextSecondary}"
                                  Width="14" Height="14" Margin="0,0,4,0"
                                  Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVisibility}}" />
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Unlock}" Stroke="{StaticResource Brush.Success}"
                                  Width="14" Height="14" Margin="0,0,4,0"
                                  Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding LockChipText}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Small}"
                                       AutomationProperties.Name="Estado del bloqueo" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}"
                            Visibility="{Binding Test.IsArchived, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <TextBlock Text="Archivado" Foreground="{StaticResource Brush.TextMuted}" FontSize="{StaticResource FontSize.Small}" />
                    </Border>
                </WrapPanel>
            </DockPanel>

            <!-- One-line header + indicator tiles -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <WrapPanel Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Fecha" /> <Run Style="{StaticResource InfoValue}" Text="{Binding TestDateText, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Cliente" /> <Run Style="{StaticResource InfoValue}" Text="{Binding Test.ClientName, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Proveedor" /> <Run Style="{StaticResource InfoValue}" Text="{Binding Test.ConcreteProviderName, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Dosificación" /> <Run Style="{StaticResource InfoValue}" Text="{Binding DesignText, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource InfoItem}"><Run Style="{StaticResource InfoLabel}" Text="Ubicación" /> <Run Style="{StaticResource InfoValue}" Text="{Binding Test.Address, Mode=OneWay}" /></TextBlock>
                </WrapPanel>

                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Tile}" Margin="0,0,12,0" Padding="14,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Probetas" />
                            <TextBlock Style="{StaticResource TileValueLarge}" Text="{Binding ActiveCount}" AutomationProperties.Name="Probetas" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="0,0,12,0" Padding="14,8" Background="{StaticResource Brush.ErrorSoft}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Para romper (hoy o antes)" Foreground="{StaticResource Brush.Error}" />
                            <TextBlock Style="{StaticResource TileValueLarge}" Text="{Binding DueCount}" Foreground="{StaticResource Brush.Error}"
                                       AutomationProperties.Name="Probetas para romper" ToolTip="{Binding DueText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="0,0,12,0" Padding="14,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Rotas" />
                            <TextBlock Style="{StaticResource TileValueLarge}" AutomationProperties.Name="Rotas">
                                <Run Text="{Binding TestedCount, Mode=OneWay}" />
                                <Run Text="{Binding TestedText, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Brush.TextMuted}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Padding="14,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabel}" Text="Resistencia media (kg/cm²)" />
                            <TextBlock Style="{StaticResource TileValueLarge}" AutomationProperties.Name="Resistencia media">
                                <Run Text="{Binding AverageStrengthText, Mode=OneWay}" />
                                <Run Text="{Binding AveragePercentText, Mode=OneWay}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Brush.Success}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- Active filter -->
            <Border Grid.Row="2" Background="{StaticResource Brush.PrimarySoft}" CornerRadius="{StaticResource Radius.Control}"
                    Padding="10,4" Margin="0,0,0,8"
                    Visibility="{Binding HasFilter, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="Quitar filtro"
                            Command="{Binding ClearFilterCommand}" b:ButtonIcon.Icon="{StaticResource Icon.FilterOff}" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="Filtro:" FontWeight="SemiBold" />
                        <Run Text="{Binding FilterText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Probetas: toolbar, table and legend in one card -->
            <Border Grid.Row="3" MinHeight="180" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,8,12,0">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Filtrar…" Command="{Binding FilterCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Filter}"
                                    Margin="8,0,0,8" ToolTip="Por fecha de moldeo o número de probeta" />
                            <CheckBox Content="Mostrar archivadas" IsChecked="{Binding IncludeArchived}" VerticalAlignment="Center" Margin="12,0,0,8" />
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Refresh}" Margin="8,0,0,8"
                                    ToolTip="Actualizar (F5)" AutomationProperties.Name="Actualizar" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Probetas" Margin="0,0,12,8" VerticalAlignment="Center" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Nueva probeta" Command="{Binding NewSpecimenCommand}"
                                    b:ButtonIcon.Icon="{StaticResource Icon.Plus}" Margin="0,0,8,8"
                                    ToolTip="{Binding NewSpecimenToolTip}" ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Registrar rotura" Command="{Binding RecordRuptureCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Specimen}"
                                    Margin="0,0,8,8" ToolTip="Rotura de la probeta seleccionada (Ctrl+R; también doble clic)" />
                            <Button Content="Editar" Command="{Binding EditSpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Edit}" Margin="0,0,8,8"
                                    ToolTip="Todos los datos de la probeta" />
                            <Button Content="Copiar" Command="{Binding CopySpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Copy}" Margin="0,0,8,8"
                                    ToolTip="Nueva probeta con las medidas de la seleccionada" />
                            <Button Content="{Binding ArchiveText}" Command="{Binding ToggleArchiveSpecimenCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Archive}"
                                    Margin="0,0,8,8" ToolTip="{Binding ArchiveToolTip}" ToolTipService.ShowOnDisabled="True" />
                        </WrapPanel>
                    </DockPanel>

                    <!-- Count + colour legend -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="12,6,12,8">
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding CountText}" Margin="0,0,24,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Swatch}" Background="{StaticResource Brush.RowOverdue}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Retrasada" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Swatch}" Background="{StaticResource Brush.RowDueSoon}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" Text="Romper hoy o mañana" VerticalAlignment="Center" />
                    </WrapPanel>

                    <Grid>
                        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" BorderThickness="0,1"
                                  RowStyle="{StaticResource SpecimenRow}"
                                  b:DataGridBehavior.OpenCommand="{Binding OpenSpecimenCommand}"
                                  AutomationProperties.Name="Probetas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="50" MinWidth="50" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Code}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="Slump (cm)" Binding="{Binding Slump, StringFormat=0.00}" Width="88" MinWidth="88" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Moldeo" Binding="{Binding MoldDate, StringFormat=dd/MM/yyyy}" Width="90" MinWidth="90" />
                                <DataGridTextColumn Header="Rotura" Binding="{Binding RuptureDate, StringFormat=dd/MM/yyyy}" Width="90" MinWidth="90" />
                                <DataGridTextColumn Header="Edad" Binding="{Binding AgeDays}" Width="52" MinWidth="52" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Ø (cm)" Binding="{Binding DiameterCm, StringFormat=0.00}" Width="68" MinWidth="68" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Altura (cm)" Binding="{Binding HeightCm, StringFormat=0.00}" Width="88" MinWidth="88" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Peso (kg)" Binding="{Binding WeightKg, StringFormat=0.000}" Width="80" MinWidth="80" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Densidad (kg/m³)" Binding="{Binding DensityKgPerM3, StringFormat=0.00}" Width="124" MinWidth="124" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Rotura (t)" Binding="{Binding RuptureLoadTon, StringFormat=0.00}" Width="80" MinWidth="80" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Resist. (kg/cm²)" Binding="{Binding StrengthKgPerCm2, StringFormat=0.00}" Width="118" MinWidth="118" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="% fck" Binding="{Binding PercentOfFck, StringFormat={}{0:0} %, TargetNullValue=''}" Width="60" MinWidth="60" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="82" MinWidth="82" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ProgressBar VerticalAlignment="Top" Height="3" Margin="1,1,1,0" IsIndeterminate="{Binding IsLoading}"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource EmptyState}" Text="{Binding EmptyText}"
                                   Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
