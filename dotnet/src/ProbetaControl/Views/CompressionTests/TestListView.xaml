<UserControl x:Class="ProbetaControl.Views.CompressionTests.TestListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>

    <ContentControl Style="{StaticResource ListPageFrame}">
        <!-- Filters: one client, and only tests with specimens to break. -->
        <ContentControl.Tag>
            <WrapPanel Style="{StaticResource Toolbar}">
                <TextBlock Text="Cliente:" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,0,8,8" />
                <Button Command="{Binding ChooseClientFilterCommand}" b:ButtonIcon.Icon="{StaticResource Icon.Filter}"
                        MaxWidth="320" Margin="0,0,4,8" ToolTip="Mostrar solo los ensayos de un cliente"
                        AutomationProperties.Name="Filtrar por cliente">
                    <TextBlock Text="{Binding ClientFilterText}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding ClearClientFilterCommand}"
                        b:ButtonIcon.Icon="{StaticResource Icon.Close}" Margin="0,0,16,8"
                        ToolTip="Mostrar todos los clientes" AutomationProperties.Name="Quitar filtro de cliente"
                        Visibility="{Binding HasClientFilter, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox Content="{Binding OnlyDueText}" IsChecked="{Binding OnlyDue}" VerticalAlignment="Center"
                          Margin="8,0,0,8" ToolTip="Ensayos con probetas sin romper cuya fecha de rotura es hoy o ya pasó" />
            </WrapPanel>
        </ContentControl.Tag>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  RowStyle="{StaticResource ListPageDataGridRow}"
                  b:DataGridBehavior.OpenCommand="{Binding EditCommand}"
                  AutomationProperties.Name="{Binding Title}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="70" MinWidth="60"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Fecha" Binding="{Binding TestDate, StringFormat=dd/MM/yyyy}" Width="100" MinWidth="95" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding ClientName}" Width="*" MinWidth="150" />
                <DataGridTextColumn Header="Proyecto" Binding="{Binding ProjectName}" Width="*" MinWidth="150" />
                <DataGridTextColumn Header="Ubicación" Binding="{Binding Address}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Probetas" Binding="{Binding SpecimenCount}" Width="80" MinWidth="75"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTemplateColumn Header="Para romper" Width="100" MinWidth="95" SortMemberPath="DueCount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Red badge: untested specimens due today or earlier. -->
                            <Border x:Name="Badge" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="8,0"
                                    Background="{StaticResource Brush.ErrorSoft}" CornerRadius="9"
                                    ToolTip="Probetas sin romper con fecha de rotura hoy o anterior">
                                <TextBlock Text="{Binding DueCount}" Foreground="{StaticResource Brush.Error}" FontWeight="SemiBold" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DueCount}" Value="0">
                                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </ContentControl>
</UserControl>
