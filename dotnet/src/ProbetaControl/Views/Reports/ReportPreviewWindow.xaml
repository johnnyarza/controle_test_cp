<Window x:Class="ProbetaControl.Views.Reports.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors"
        Style="{StaticResource AppWindow}"
        Title="{Binding Title}"
        AutomationProperties.Name="{Binding Title}"
        Width="1100" Height="760" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SavePdfCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding FitWidthCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: output on the left, zoom in the middle, Cerrar on the right. -->
        <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <!-- IsCancel closes the window (also with Esc). -->
                <Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True"
                        b:ButtonIcon.Icon="{StaticResource Icon.Close}" />

                <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="Imprimir…" Command="{Binding PrintCommand}"
                        b:ButtonIcon.Icon="{StaticResource Icon.Print}" Margin="0,0,8,0"
                        ToolTip="Elegir la impresora y las hojas, e imprimir (Ctrl+P)" />
                <Button DockPanel.Dock="Left" Content="Guardar PDF…" Command="{Binding SavePdfCommand}"
                        b:ButtonIcon.Icon="{StaticResource Icon.Save}" Margin="0,0,24,0"
                        ToolTip="Guardar el informe como archivo PDF, por ejemplo para enviarlo por correo (Ctrl+S)" />

                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="−" FontSize="16" MinWidth="32"
                        Command="{Binding ZoomOutCommand}" ToolTip="Alejar (Ctrl+−)" AutomationProperties.Name="Alejar" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="48"
                           TextAlignment="Center" AutomationProperties.Name="Zoom" />
                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="+" FontSize="16" MinWidth="32"
                        Command="{Binding ZoomInCommand}" ToolTip="Acercar (Ctrl++)" AutomationProperties.Name="Acercar" />
                <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="Ancho de página" Margin="4,0,0,0"
                        Command="{Binding FitWidthCommand}" ToolTip="Ajustar la hoja al ancho de la ventana (Ctrl+0)" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding PageCountText}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource MessageBanner}" Margin="16,10,16,0">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <!-- The sheets, one under the other; only the visible ones are built and drawn. -->
        <ListBox x:Name="PageList" Grid.Row="2" ItemsSource="{Binding Pages}" Background="{StaticResource Brush.SurfaceMuted}"
                 BorderThickness="0" Padding="0,12" Focusable="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                 ScrollViewer.PanningMode="Both"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 AutomationProperties.Name="Hojas del informe">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <!-- Pages are not selectable: no highlight, just the sheet. -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Margin="24,6" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Border Background="White" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                Width="{Binding Width}" Height="{Binding Height}" SnapsToDevicePixels="True">
                            <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- While the data is read and the pages are laid out. -->
        <Grid Grid.Row="2" Background="{StaticResource Brush.SurfaceMuted}" Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,0,0,10" />
                <TextBlock Text="Preparando el informe…" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
