<!-- Clients and providers (same columns). -->
<UserControl x:Class="ProbetaControl.Views.Catalog.ContactListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    </UserControl.InputBindings>

    <ContentControl Style="{StaticResource ListPageFrame}">
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  RowStyle="{StaticResource ListPageDataGridRow}"
                  b:DataGridBehavior.OpenCommand="{Binding EditCommand}"
                  AutomationProperties.Name="{Binding Title}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*" MinWidth="180" />
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Phone}" Width="*" MinWidth="110" />
                <DataGridTextColumn Header="Dirección" Binding="{Binding Address}" Width="2*" MinWidth="160" />
                <DataGridTextColumn Header="Correo electrónico" Binding="{Binding Email}" Width="2*" MinWidth="160" />
            </DataGrid.Columns>
        </DataGrid>
    </ContentControl>
</UserControl>
