<UserControl x:Class="ProbetaControl.Views.Catalog.DesignListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:ProbetaControl.Views.Behaviors">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,4,0" />
        </Style>
        <Style x:Key="SummaryCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding MaterialsSummary}" />
        </Style>
    </UserControl.Resources>

    <ContentControl Style="{StaticResource ListPageFrame}">
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  RowStyle="{StaticResource ListPageDataGridRow}"
                  b:DataGridBehavior.OpenCommand="{Binding EditCommand}"
                  AutomationProperties.Name="{Binding Title}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="2*" MinWidth="150" />
                <DataGridTextColumn Header="fck (kg/cm²)" Binding="{Binding Fck, StringFormat=0.##}" Width="90" MinWidth="80"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Slump (cm)" Binding="{Binding Slump, StringFormat=0.##}" Width="90" MinWidth="80"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="a/c" Binding="{Binding WaterCementRatio, StringFormat=0.00}" Width="60" MinWidth="55"
                                    ElementStyle="{StaticResource NumberCell}" />
                <DataGridTextColumn Header="Materiales (kg/m³)" Binding="{Binding MaterialsSummary}" Width="4*" MinWidth="220"
                                    ElementStyle="{StaticResource SummaryCell}" />
            </DataGrid.Columns>
        </DataGrid>
    </ContentControl>
</UserControl>
